{
  "name": "medslot",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:setup": "npm --prefix server run db:setup",
    "dev": "concurrently -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=4000 npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test",
    "build": "npm --prefix client run build",
    "render-build": "npm ci --prefix server --include=dev && npm ci --prefix client --include=dev && npm run build --prefix client",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": "22.x"
  }
}
